# Copy to env/app.staging.env, fill secrets, then:
#   gh secret set APP_ENV_STAGING < env/app.staging.env
#
# Dùng cho branch `preview` (auto-deploy).

DEPLOY_PATH=/home/YOUR_USER/plane-staging

APP_DOMAIN=plane-staging.example.com
WEB_URL=https://plane-staging.example.com
DEBUG=0
CORS_ALLOWED_ORIGINS=https://plane-staging.example.com
API_BASE_URL=http://api:8000

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0

# DB
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:CHANGE_ME@plane-db:5432/plane

# Redis
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:CHANGE_ME@plane-mq:5672/plane

# Secrets
SECRET_KEY=CHANGE_ME_LONG_RANDOM
LIVE_SERVER_SECRET_KEY=CHANGE_ME_LONG_RANDOM

# Object storage (MinIO in compose)
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0

GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
